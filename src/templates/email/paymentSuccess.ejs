<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Successful | EGG ATM</title>
  <style>
    /* Reset Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333333;
      background-color: #f8f9fa;
      padding: 20px;
    }
    
    /* Email Container */
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
    
    /* Header */
    .header {
      background: linear-gradient(135deg, #faa807 0%, #ffd13d 100%);
      padding: 40px 30px;
      text-align: center;
      color: white;
      position: relative;
      overflow: hidden;
    }
    
    .header:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.1" d="M0,224L48,213.3C96,203,192,181,288,181.3C384,181,480,203,576,197.3C672,192,768,160,864,154.7C960,149,1056,171,1152,165.3C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
      background-size: cover;
    }
    
    .header-content {
      position: relative;
      z-index: 2;
    }
    
    .logo {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 10px;
    }
    
    .success-icon {
      width: 80px;
      height: 80px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 36px;
      color: #4CAF50;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    
    .header h1 {
      font-size: 32px;
      margin-bottom: 10px;
      font-weight: 700;
    }
    
    /* Content */
    .content {
      padding: 40px 30px;
    }
    
    .greeting {
      font-size: 18px;
      margin-bottom: 25px;
      color: #555555;
    }
    
    .highlight {
      color: #faa807;
      font-weight: bold;
    }
    
    /* Order Summary */
    .order-summary {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      border-radius: 12px;
      padding: 25px;
      margin: 30px 0;
      border-left: 4px solid #faa807;
    }
    
    .summary-title {
      color: #faa807;
      font-size: 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .summary-details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
    }
    
    .detail-row {
      display: flex;
      justify-content: space-between;
      padding-bottom: 12px;
      border-bottom: 1px dashed #ddd;
    }
    
    .detail-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    
    .detail-label {
      color: #666666;
      font-weight: 500;
    }
    
    .detail-value {
      color: #333333;
      font-weight: 600;
    }
    
    .amount {
      color: #4CAF50;
      font-size: 24px;
      font-weight: 700;
    }
    
    .status-badge {
      background: #4CAF50;
      color: white;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      display: inline-block;
    }
    
    /* Next Steps */
    .next-steps {
      background: #fff9e6;
      border-radius: 12px;
      padding: 25px;
      margin: 30px 0;
      border: 2px dashed #ffd13d;
    }
    
    .steps-title {
      color: #faa807;
      font-size: 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .steps-list {
      list-style: none;
    }
    
    .step-item {
      padding: 10px 0;
      padding-left: 30px;
      position: relative;
      color: #666666;
    }
    
    .step-item:before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #4CAF50;
      font-weight: bold;
      font-size: 16px;
      width: 24px;
      height: 24px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    
    /* Thank You */
    .thank-you {
      text-align: center;
      padding: 30px;
      background: linear-gradient(135deg, #faa80710 0%, #ffd13d10 100%);
      border-radius: 12px;
      margin: 30px 0;
    }
    
    .thank-you h3 {
      color: #333333;
      font-size: 24px;
      margin-bottom: 10px;
    }
    
    /* Footer */
    .footer {
      background: #2c3e50;
      color: white;
      padding: 30px;
      text-align: center;
      border-bottom: 4px solid #faa807;
    }
    
    .brand-name {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 10px;
      background: linear-gradient(135deg, #faa807 0%, #ffd13d 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .brand-tagline {
      color: #95a5a6;
      font-size: 14px;
      margin-bottom: 20px;
    }
    
    .contact-info {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    
    .contact-item {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #bdc3c7;
      font-size: 14px;
    }
    
    .unsubscribe {
      color: #95a5a6;
      font-size: 12px;
      margin-top: 20px;
    }
    
    /* Responsive */
    @media (max-width: 600px) {
      .header {
        padding: 30px 20px;
      }
      
      .content {
        padding: 20px;
      }
      
      .header h1 {
        font-size: 24px;
      }
      
      .success-icon {
        width: 60px;
        height: 60px;
        font-size: 28px;
      }
      
      .contact-info {
        flex-direction: column;
        gap: 15px;
      }
      
      .detail-row {
        flex-direction: column;
        gap: 5px;
      }
    }
  </style>
</head>
<body>
  <div class="email-container">
    <!-- Header -->
    <div class="header">
      <div class="header-content">
        <div class="logo">EGG ATM</div>
        <div class="success-icon">✓</div>
        <h1>Payment Successful! 🎉</h1>
        <p>Thank you for your purchase</p>
      </div>
    </div>
    
    <!-- Content -->
    <div class="content">
      <p class="greeting">
        Hello <span class="highlight"><%= user.name %></span>,
      </p>
      
      <p>We're delighted to inform you that your payment has been processed successfully.</p>
      
      <!-- Order Summary -->
      <div class="order-summary">
        <div class="summary-title">
          <span>📋</span> Order Summary
        </div>
        <div class="summary-details">
          <div class="detail-row">
            <span class="detail-label">Order ID</span>
            <span class="detail-value"><%= order._id %></span>
          </div>
          
          <div class="detail-row">
            <span class="detail-label">Amount Paid</span>
            <span class="detail-value amount">₹<%= order.totalAmount %></span>
          </div>
          
          <div class="detail-row">
            <span class="detail-label">Payment Status</span>
            <span class="status-badge">COMPLETED</span>
          </div>
          
          <div class="detail-row">
            <span class="detail-label">Date & Time</span>
            <span class="detail-value">
              <script>
                document.write(new Date().toLocaleString('en-IN', {
                  day: '2-digit',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }));
              </script>
            </span>
          </div>
        </div>
      </div>
      
      <!-- Next Steps -->
      <div class="next-steps">
        <div class="steps-title">
          <span>📦</span> What Happens Next?
        </div>
        <ul class="steps-list">
          <li class="step-item">Order confirmation sent to your email</li>
          <li class="step-item">Your order is being processed</li>
          <li class="step-item">You'll receive tracking information soon</li>
          <li class="step-item">Expected delivery within 2-3 business days</li>
        </ul>
      </div>
      
      <!-- Thank You Message -->
      <div class="thank-you">
        <h3>Thank You for Your Order! 🙏</h3>
        <p>We truly appreciate your business and can't wait to serve you again!</p>
        <p style="margin-top: 15px; font-size: 14px; color: #666;">
          Need help? Reply to this email or contact our support team.
        </p>
      </div>
      
      <p style="margin-top: 30px; text-align: center;">
        Best regards,<br>
        <strong>The EGG ATM Team</strong>
      </p>
    </div>
    
    <!-- Footer -->
    <div class="footer">
      <div class="brand-name">EGG ATM</div>
      <div class="brand-tagline">ANY TIME MUTTAI - Fresh Eggs, Anytime!</div>
      
      <div class="contact-info">
        <div class="contact-item">
          <span>📞</span> Support: 1800-XXX-XXXX
        </div>
        <div class="contact-item">
          <span>📧</span> support@eggatm.com
        </div>
        <div class="contact-item">
          <span>🌐</span> www.eggatm.com
        </div>
      </div>
      
      <p class="unsubscribe">
        This email was sent to <%= user.email %>. 
        <br>
        © 2024 EGG ATM. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>