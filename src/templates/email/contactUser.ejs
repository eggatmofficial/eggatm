<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>We’ve received your message</title>
  </head>

  <body style="margin:0; padding:0; background:#f9fafb;">
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding:20px;">
          <table width="600" cellpadding="0" cellspacing="0"
            style="background:#ffffff; border-radius:10px; padding:30px; font-family:Arial, sans-serif; box-shadow:0 10px 30px rgba(0,0,0,0.08);">

            <!-- Logo / Header -->
            <tr>
              <td align="center" style="padding-bottom:20px;">
                <h1 style="margin:0; color:#faa807; font-size:28px;">
                  🥚 Egg! ATM
                </h1>
                <p style="margin:5px 0 0; color:#999; font-size:13px;">
                  Fresh • Fast • Delicious
                </p>
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style="color:#333; font-size:16px; line-height:1.6;">
                <p style="margin:0 0 12px;">
                  Hi <strong><%= name %></strong> 👋
                </p>

                <p style="margin:0 0 12px;">
                  Thanks for reaching out to <strong>Egg! ATM</strong>!
                </p>

                <p style="margin:0 0 16px;">
                  We’ve successfully received your message. Our team is already
                  reviewing it and we’ll get back to you within
                  <strong>24 hours</strong>.
                </p>

                <p style="margin:0 0 20px;">
                  If your query is urgent, feel free to call or WhatsApp us directly.
                </p>

                <p style="margin:0;">
                  Warm regards,<br/>
                  <strong>Egg! ATM Team</strong> 🥚
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding-top:25px; font-size:12px; color:#888;">
                This is an automated message. Please do not reply to this email.
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
